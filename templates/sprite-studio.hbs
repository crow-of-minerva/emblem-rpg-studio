<div class="ete-root">
  <div class="ete-body">
  <section class="ete-pane" data-side="avatar">
    <header class="ete-pane-header"><span>{{itemName}}</span></header>

    <div class="ete-toolbar">
      <button type="button" class="sts-btn sts-btn-sm" data-action="importImage"
        data-tooltip="Import an image from disk and convert it to pixel art"><i class="fas fa-upload"></i>
        Import</button>
      <span class="ete-toolbar-spacer"></span>
      <button type="button" class="sts-btn sts-btn-sm sts-btn-danger" data-action="clearArt"
        data-tooltip="Clear the canvas"><i class="fas fa-trash"></i></button>
    </div>

    <div class="ete-pane-work">
      {{> "modules/emblem-rpg-studio/templates/editor/tool-rail.hbs"}}
      <div class="ete-work-col">
        <div class="ete-canvas-area">
          <div class="ete-canvas-mount"></div>
        </div>
      </div>
    </div>
  </section>

  <aside class="fecc-side fecc-side-right" data-fecc-side="item">
    <div class="fecc-rail">
      <button type="button" class="fecc-rail-tab" data-action="toggleTray" data-fecc-tab="adjust"
        data-tooltip="Adjust hue, saturation, brightness and contrast"><i class="fas fa-sliders"></i>
        <span>Adjust</span></button>
      <button type="button" class="fecc-rail-tab" data-action="toggleTray" data-fecc-tab="colour"
        data-tooltip="Recolour image tones"><i class="fas fa-droplet"></i><span>Recolour</span></button>
    </div>
    <div class="fecc-side-body">
      <div class="fecc-side-pane iis-adjust" data-fecc-pane="adjust">
        <header class="fecc-panel-header"><i class="fas fa-sliders"></i><span>Adjustments</span></header>
        <div class="iis-adjust-body">
          <div class="iis-adjust-row">
            <span class="iis-adjust-label">Hue</span>
            <div class="iis-adjust-control">
              <input type="range" data-adj="hue" min="-180" max="180" step="1" value="0" disabled>
              <button type="button" class="iis-adjust-reset" data-action="adjustReset" data-adj-reset="hue"
                data-tooltip="Reset Hue" disabled><i class="fas fa-rotate-left"></i></button>
            </div>
          </div>
          <div class="iis-adjust-row">
            <span class="iis-adjust-label">Saturation</span>
            <div class="iis-adjust-control">
              <input type="range" data-adj="sat" min="-100" max="100" step="1" value="0" disabled>
              <button type="button" class="iis-adjust-reset" data-action="adjustReset" data-adj-reset="sat"
                data-tooltip="Reset Saturation" disabled><i class="fas fa-rotate-left"></i></button>
            </div>
          </div>
          <div class="iis-adjust-row">
            <span class="iis-adjust-label">Brightness</span>
            <div class="iis-adjust-control">
              <input type="range" data-adj="bright" min="-100" max="100" step="1" value="0" disabled>
              <button type="button" class="iis-adjust-reset" data-action="adjustReset" data-adj-reset="bright"
                data-tooltip="Reset Brightness" disabled><i class="fas fa-rotate-left"></i></button>
            </div>
          </div>
          <div class="iis-adjust-row">
            <span class="iis-adjust-label">Contrast</span>
            <div class="iis-adjust-control">
              <input type="range" data-adj="contrast" min="-100" max="100" step="1" value="0" disabled>
              <button type="button" class="iis-adjust-reset" data-action="adjustReset" data-adj-reset="contrast"
                data-tooltip="Reset Contrast" disabled><i class="fas fa-rotate-left"></i></button>
            </div>
          </div>
        </div>
        <div class="iis-adjust-actions">
          <button type="button" class="sts-btn sts-btn-sm sts-btn-primary" data-action="adjustApply"
            disabled><i class="fas fa-check"></i> Apply</button>
          <button type="button" class="sts-btn sts-btn-sm" data-action="adjustCancel"
            disabled><i class="fas fa-xmark"></i> Cancel</button>
        </div>
      </div>
      <div class="fecc-side-pane" data-fecc-pane="colour">
        <div class="iis-recolour-root" data-recolour-root></div>
      </div>
    </div>
  </aside>
  </div>

  <footer class="ete-footer">
    <button type="button" class="sts-btn" data-action="cancel">Cancel</button>
    <span class="ete-footer-acts">
      <button type="button" class="sts-btn ete-save" data-action="save"><i class="fas fa-stamp"></i> Save</button>
    </span>
  </footer>
</div>
