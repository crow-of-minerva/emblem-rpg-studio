{{!-- One pane's toolbar. Spritesheet tabs leave out the HP/Stn bar guide and the map-scale preview, which both
     describe one token cell, and Save Sheet is their only save. A scratch tab has no destination, so each pane's
     Save button is disabled with the reason as its tooltip, as Submit's is. --}}
<div class="ete-toolbar">
  <button type="button" class="sts-btn sts-btn-sm" data-action="uploadFile"
    data-tooltip="Upload from computer"><i class="fas fa-upload"></i></button>
  <button type="button" class="sts-btn sts-btn-sm" data-action="useOtherCanvas"
    data-tooltip="Copy other canvas in"><i class="fas fa-arrow-right-long"></i></button>
  <span class="ete-toolbar-spacer"></span>
  <button type="button" class="sts-btn sts-btn-sm" data-action="saveProject"
    data-tooltip="Save every tab as a project file"><i class="fas fa-floppy-disk"></i></button>
  <button type="button" class="sts-btn sts-btn-sm" data-action="loadProject"
    data-tooltip="Load a project"><i class="fas fa-folder-open"></i></button>
  <button type="button" class="sts-btn sts-btn-sm sts-btn-danger" data-action="clearLayers"
    data-tooltip="Clear all layers"><i class="fas fa-trash"></i></button>
  <span class="ete-toolbar-spacer"></span>
  <button type="button" class="sts-btn sts-btn-sm" data-action="toggleGrid"
    data-tooltip="Gridlines: Off"><i class="fas fa-border-all"></i></button>
  {{#if token}}{{#unless sheet}}
  <button type="button" class="sts-btn sts-btn-sm" data-action="toggleBar"
    data-tooltip="Toggle HP/Stn bar guide"><i class="fas fa-grip-lines"></i></button>
  <button type="button" class="sts-btn sts-btn-sm" data-action="togglePreview"
    data-tooltip="Preview token at map scale"><i class="fas fa-eye"></i></button>
  {{/unless}}{{/if}}
  <span class="ete-toolbar-spacer"></span>
  {{#if sheet}}
  {{#if token}}
  <button type="button" class="sts-btn sts-btn-sm sts-btn-primary" data-action="saveSheet"
    data-tooltip="Save the spritesheet to the actor and its character folder"><i class="fas fa-stamp"></i>
    Save Sheet</button>
  {{/if}}
  {{else}}
  <button type="button" class="sts-btn sts-btn-sm sts-btn-primary"
    data-action="{{#if token}}saveToken{{else}}saveAvatar{{/if}}"
    {{#if unbound}}
    disabled data-tooltip="No destination yet. Pick a Class / Entry / Type and press Submit first"
    {{else}}
    data-tooltip="Save this pane to its destination on the actor"
    {{/if}}><i class="fas fa-stamp"></i>
    Save</button>
  {{#if token}}
  <button type="button" class="sts-btn sts-btn-sm sts-btn-primary" data-action="saveAllTabs"
    data-tooltip="Save every open tab to its destination on the actor"><i class="fas fa-layer-group"></i>
    Save All</button>
  {{/if}}
  {{/if}}
</div>
